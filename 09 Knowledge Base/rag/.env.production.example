# TenantIQ RAG production environment template
# Copy these values into your hosting platform's secret/environment configuration.

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5

# Managed PostgreSQL with pgvector enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tenantiq

# Must match the TenantIQ web application's TENANTIQ_INTERNAL_API_SECRET exactly.
TENANTIQ_INTERNAL_API_SECRET=

TENANTIQ_API_HOST=0.0.0.0
TENANTIQ_API_PORT=8787

# Comma-separated origins allowed to call the FastAPI service directly.
# Keep this restricted to trusted TenantIQ web origins.
TENANTIQ_ALLOWED_ORIGINS=https://tenantiq365.com,https://www.tenantiq365.com
